{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Cloudflare 대시보드에 표시될 Worker 이름 (주소: unipath-life.<계정>.workers.dev)
  "name": "unipath-life",
  "main": "vinext/server/fetch-handler",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "unipath-life-db",
      // `npx wrangler d1 create unipath-life-db` 로 만든 뒤 출력되는 database_id 로 바꿔 주세요.
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "drizzle"
    }
  ]
  // 비밀값(ADMIN_PASSWORD, SESSION_SECRET)은 이 파일에 쓰지 말고
  // `npx wrangler secret put ADMIN_PASSWORD` 로 등록합니다.
}
