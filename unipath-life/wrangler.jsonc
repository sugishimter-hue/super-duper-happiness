{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Cloudflare 대시보드에 표시될 Worker 이름 (주소: unipath-life.<계정>.workers.dev)
  "name": "unipath-life",
  "main": "vinext/server/fetch-handler",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "unipath-life-db",
      // database_id 를 비워 두면 첫 배포 때 Cloudflare 가 이 이름으로 D1 을 자동으로 만듭니다.
      "migrations_dir": "drizzle"
    }
  ]
  // 비밀값(ADMIN_PASSWORD, SESSION_SECRET)은 이 파일에 쓰지 말고
  // Cloudflare 대시보드 > Settings > Variables and Secrets 에 Secret 으로 등록합니다.
}
