# Claude API 키 (https://console.anthropic.com 에서 발급)
ANTHROPIC_API_KEY=
# 포트 (기본 3000)
PORT=3000

# ── Google 연동 (선택) ── README의 "Google 연동 준비"를 따라 발급
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 앱 주소 (내 PC에서 쓰면 비워 두세요. 인터넷에 배포할 때만 https://내도메인 입력)
APP_URL=

# ── 카카오톡 알림 (선택) ── README의 "카카오톡 알림 준비"를 따라 발급
KAKAO_REST_API_KEY=
# 카카오 개발자 콘솔에서 Client Secret 을 "사용"으로 켰을 때만 입력
KAKAO_CLIENT_SECRET=
